def font(path: str, size: int) -> ImageFont.FreeTypeFont:
    return ImageFont.truetype(path, size)


def ff(*args: str) -> None:
    r = subprocess.run([FFMPEG, "-y", *args], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if r.returncode != 0:
        raise RuntimeError(r.stderr[-2000:])


def header(draw: ImageDraw.ImageDraw, title: str, subtitle: str) -> None:
    draw.rectangle([0, 0, WIDTH, 12], fill=TEAL)
    draw.text((100, 70), title, font=font(FONT_BOLD, 48), fill=WHITE)
    draw.text((100, 140), subtitle, font=font(FONT_REG, 28), fill=TEAL)
    draw.text((100, 1020), "learn_clustering  —  03 greedy pair merge", font=font(FONT_REG, 20), fill=MUTED)


def create_text_slide(title: str, subtitle: str, bullets: list[str], filepath: Path) -> None:
    img = Image.new("RGB", (WIDTH, HEIGHT), BG)
    draw = ImageDraw.Draw(img)
    header(draw, title, subtitle)
    draw.rounded_rectangle([100, 220, 1820, 980], radius=24, fill=CARD)
    y = 280
    bullet_font = font(FONT_REG, 34)
    for item in bullets:
        draw.ellipse([150, y + 12, 174, y + 36], fill=TEAL)
        draw.text((210, y), item, font=bullet_font, fill=WHITE)
        y += 130
    img.save(filepath)


def create_graph_slide(title: str, subtitle: str, step: int, facts: list[str], filepath: Path) -> None:
    img = Image.new("RGB", (WIDTH, HEIGHT), BG)
    draw = ImageDraw.Draw(img)
    header(draw, title, subtitle)
    draw.rounded_rectangle([80, 210, 1080, 990], radius=24, fill=CARD)
    draw.rounded_rectangle([1120, 210, 1840, 990], radius=24, fill=CARD)

    pos = {
        "A": (280, 340),
        "B": (860, 320),
        "C": (560, 560),
        "E": (300, 820),
        "D": (860, 800),
    }
    edges = [("A", "B", "5"), ("A", "C", "1"), ("B", "C", "4"), ("C", "D", "2"), ("C", "E", "1"), ("D", "E", "5")]
    node_colors = {
        1: {n: TEAL for n in pos},
        2: {"A": ORANGE, "B": ORANGE, "C": TEAL, "D": BLUE, "E": BLUE},
        3: {"A": TEAL, "B": TEAL, "C": TEAL, "D": BLUE, "E": BLUE},
        4: {"A": TEAL, "B": TEAL, "C": TEAL, "D": ORANGE, "E": ORANGE},
        5: {"A": TEAL, "B": TEAL, "C": TEAL, "D": BLUE, "E": BLUE},
    }[step]
    hot = {1: {("A", "B")}, 2: {("A", "B")}, 3: {("A", "C"), ("B", "C")}, 4: {("D", "E")}, 5: {("C", "D"), ("C", "E")}}[step]
    dim = {1: set(), 2: set(), 3: {("A", "B")}, 4: {("A", "B"), ("A", "C"), ("B", "C")}, 5: {("A", "B"), ("A", "C"), ("B", "C"), ("D", "E")}}[step]

    def undirected(a: str, b: str) -> tuple[str, str]:
        return (a, b) if a < b else (b, a)

    for u, v, w in edges:
        x1, y1 = pos[u]
        x2, y2 = pos[v]
        key = undirected(u, v)
        if key in hot:
            color, width = ORANGE, 10
        elif key in dim:
            color, width = (71, 85, 105), 5
        else:
            color, width = MUTED, 7
        draw.line([(x1, y1), (x2, y2)], fill=color, width=width)
        mx, my = (x1 + x2) // 2, (y1 + y2) // 2
        draw.rounded_rectangle([mx + 8, my - 28, mx + 52, my + 8], radius=8, fill=SLATE)
        draw.text((mx + 16, my - 24), w, font=font(FONT_BOLD, 22), fill=WHITE)

    for name, (x, y) in pos.items():
        r = 48
        draw.ellipse([x - r, y - r, x + r, y + r], fill=node_colors[name])
        tw = draw.textlength(name, font=font(FONT_BOLD, 32))
        draw.text((x - tw / 2, y - 18), name, font=font(FONT_BOLD, 32), fill=WHITE)

    y = 270
    draw.text((1180, y), "Walkthrough", font=font(FONT_BOLD, 30), fill=TEAL)
    y = 340
    for fact in facts:
        draw.ellipse([1180, y + 14, 1200, y + 34], fill=TEAL)
        draw.text((1220, y), fact, font=font(FONT_REG, 28), fill=WHITE)
        y += 90

    img.save(filepath)


def write_pdf(images: list[Path], dest: Path) -> None:
    pages = [Image.open(p).convert("RGB") for p in images]
    pages[0].save(dest, save_all=True, append_images=pages[1:], resolution=150.0)
    for page in pages:
        page.close()


def slide_cues(audio_dur: float) -> list[tuple[float, float]]:
    weights = [max(len(s["script"]), 1) for s in slides_data]
    total = sum(weights)
    t = 0.0
    cues = []
    for w in weights:
        d = audio_dur * w / total
        cues.append((t, t + d))
        t += d
    cues[-1] = (cues[-1][0], audio_dur)
    return cues


def write_cue_sheet(cues: list[tuple[float, float]], dest: Path) -> None:
    lines = [
        "# Synced cues: Natasha VO + greedy-pair-merge.html + video_generate_2",
        f"# Voice: {VOICE.relative_to(ROOT)}  (TTSOL-en-AU-Natasha)",
        f"# Duration: {cues[-1][1]:.2f}s  — split by script character length from video_generate_2",
        "",
    ]
    for i, ((start, end), slide) in enumerate(zip(cues, slides_data), start=1):
        lines.append(f"{i}\t{start:.2f}\t{end:.2f}\t{slide['title']}")
    dest.write_text("\n".join(lines) + "\n", encoding="utf-8")


def create_presentation() -> None:
    if not VOICE.exists():
        raise SystemExit(f"missing voiceover: {VOICE}")
    FRAMES.mkdir(parents=True, exist_ok=True)
    VIDEO_OUT.parent.mkdir(parents=True, exist_ok=True)
    audio_dur = float(AudioFileClip(str(VOICE)).duration)
    cues = slide_cues(audio_dur)
    write_cue_sheet(cues, CUES)

    pngs: list[Path] = []
    print("Generating slide frames synced to Natasha voiceover...")
    for idx, slide in enumerate(slides_data, start=1):
        png = FRAMES / f"slide{idx}.png"
        if slide["type"] == "text":
            create_text_slide(slide["title"], slide["subtitle"], slide["bullets"], png)
        else:
            create_graph_slide(slide["title"], slide["subtitle"], slide["step"], slide["facts"], png)
        pngs.append(png)
        start, end = cues[idx - 1]
        print(f"slide {idx}/{len(slides_data)}: {start:6.1f}-{end:6.1f}s  {slide['title']}")

    write_pdf(pngs, PDF_OUT)

    with tempfile.TemporaryDirectory() as tmp:
        listing = Path(tmp) / "list.txt"
        rows = []
        for png, (start, end) in zip(pngs, cues):
            rows.append(f"file '{png}'\n")
            rows.append(f"duration {end - start:.3f}\n")
        rows.append(f"file '{pngs[-1]}'\n")
        listing.write_text("".join(rows), encoding="utf-8")
        print("Compiling MP4 with Natasha voiceover...")
        ff(
            "-f", "concat",
            "-safe", "0",
            "-i", str(listing),
            "-i", str(VOICE),
            "-map", "0:v:0",
            "-map", "1:a:0",
            "-c:v", "libx264",
            "-tune", "stillimage",
            "-preset", "veryfast",
            "-pix_fmt", "yuv420p",
            "-c:a", "aac",
            "-t", f"{audio_dur:.3f}",
            "-shortest",
            str(VIDEO_OUT),
        )

    print(f"\nSuccess! Presentation video: {VIDEO_OUT}")
    print(f"Updated slides PDF: {PDF_OUT}")
    print(f"Cue sheet: {CUES}")


if __name__ == "__main__":
    os.chdir(SLIDES_DIR)
    create_presentation()
